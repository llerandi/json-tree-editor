{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "build": {
    "distDir": "../src"
  },
  "package": {
    "productName": "JSON Tree Editor",
    "version": "0.1.0"
  },
  "tauri": {
    "withGlobalTauri": true,
    "allowlist": {
      "all": false,
      "dialog": {
        "save": true,
        "open": true
      },
      "fs": {
        "readFile": true,
        "writeFile": true,
        "scope": ["**"]
      }
    },
    "bundle": {
      "active": true,
      "identifier": "com.treeform.json-tree-editor",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ]
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "JSON Tree Editor",
        "width": 1100,
        "height": 750,
        "minWidth": 600,
        "minHeight": 400,
        "resizable": true
      }
    ]
  }
}
